#!/usr/bin/env bash
# devfetch - neofetch-style spec screen for photographing a Chromebook for sale.
#
# Live values (CPU, RAM, OS, kernel, dev tools) are detected; anything Crostini
# can't see (model, real SSD size, display) comes from the config file.
#
#   devfetch                     show the screen
#   devfetch --set KEY "value"   set/override a field (any KEY adds a custom line)
#   devfetch --unset KEY         remove a field / go back to auto-detect
#   devfetch --config            print the config
#   devfetch --edit              open the config in an editor
#   devfetch --help

set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/devfetch"
CONFIG="$CONFIG_DIR/config"

# Built-in fields, in display order. Values are auto-detected unless set in config.
BUILTIN=(MODEL CPU RAM STORAGE DISPLAY OS KERNEL TOOLS)
# Settings that tune the screen rather than adding a line.
SETTINGS=(HEADER TAGLINE ACCENT BIG FONT COLORS)

default_config() {
  cat <<'EOF'
MODEL=Dell Latitude 5300 2-in-1 Chromebook
STORAGE=128 GB SSD
DISPLAY=13.3" FHD touchscreen, 360° hinge
TAGLINE=Full Linux dev environment, ready out of the box
EOF
}

declare -A CFG=()
CFG_KEYS=()

load_config() {
  if [[ ! -f $CONFIG ]]; then
    mkdir -p "$CONFIG_DIR"
    default_config >"$CONFIG"
  fi
  local k v
  while IFS='=' read -r k v || [[ -n $k ]]; do
    [[ -z $k || $k == \#* ]] && continue
    [[ -v CFG[$k] ]] || CFG_KEYS+=("$k")
    CFG[$k]=$v
  done <"$CONFIG"
}

save_config() {
  local tmp k
  tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
  for k in "${CFG_KEYS[@]}"; do
    [[ -v CFG[$k] ]] && printf '%s=%s\n' "$k" "${CFG[$k]}"
  done >"$tmp"
  mv "$tmp" "$CONFIG"
}

normalize_key() {
  local k=${1^^}
  k=${k// /_}
  [[ $k =~ ^[A-Z0-9_]+$ ]] || { echo "devfetch: invalid key '$1' (use letters, digits, _)" >&2; exit 1; }
  printf '%s' "$k"
}

# --- auto-detection ---------------------------------------------------------

detect_cpu() {
  local name threads
  name=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2-)
  name=${name//(R)/}; name=${name//(TM)/}; name=${name/ CPU/}
  name=$(echo $name)  # squeeze whitespace
  threads=$(nproc)
  printf '%s (%s threads)' "$name" "$threads"
}

detect_ram() {
  # Crostini sees slightly less than installed RAM; round up to a multiple of 4 GB.
  local kb gb
  kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  gb=$(( (kb * 1024 / 1000000000 + 3) / 4 * 4 ))
  printf '%s GB' "$gb"
}

detect_os() {
  local pretty
  pretty=$(. /etc/os-release && echo "${NAME%% *} $VERSION_ID ${VERSION_CODENAME:-}")
  pretty=${pretty% }
  if [[ -e /dev/.cros_milestone || $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == ChromiumOS ]]; then
    printf 'ChromeOS + %s Linux (Crostini)' "$pretty"
  else
    printf '%s' "$pretty"
  fi
}

detect_tools() {
  local t found=()
  for t in git gh python3 node docker go rustc gcc java code vim; do
    command -v "$t" >/dev/null 2>&1 && found+=("$t")
  done
  local IFS='·'
  printf '%s' "${found[*]}" | sed 's/·/ · /g'
}

field_value() {
  local k=$1
  if [[ -v CFG[$k] ]]; then printf '%s' "${CFG[$k]}"; return; fi
  case $k in
    CPU) detect_cpu ;;
    RAM) detect_ram ;;
    OS) detect_os ;;
    KERNEL) uname -r ;;
    TOOLS) detect_tools ;;
  esac
}

label_for() {
  case $1 in
    TOOLS) echo "Dev tools" ;;
    OS) echo "OS" ;;
    CPU) echo "CPU" ;;
    RAM) echo "RAM" ;;
    *) local l=${1//_/ }; l=${l,,}; echo "${l^}" ;;
  esac
}

# --- rendering --------------------------------------------------------------

# Draws one headline segment. A trailing word such as "RAM" or "SSD" gets the
# second colour, so "32 GB" and "RAM" are told apart. Prints coloured rows, all
# padded to the same visible width ("#" is left for the caller to make solid).
banner_segment() {
  local text=$1 c1=$2 c2=$3 font=$4 R=$'\e[0m'
  local main=$text unit="" last=${text##* }
  if [[ $text == *" "* && $last =~ ^[A-Za-z]+$ && ! $last =~ ^[KMGT]B$ ]]; then
    main=${text% *}; unit=$last
  fi
  local -a a b=()
  mapfile -t a < <(figlet -w 1000 -f "$font" "$main")
  [[ -n $unit ]] && mapfile -t b < <(figlet -w 1000 -f "$font" "$unit")
  local wa wb=0 widest='{ if (length > m) m = length } END { print m + 0 }'
  wa=$(printf '%s\n' "${a[@]}" | awk "$widest")
  (( ${#b[@]} )) && wb=$(printf '%s\n' "${b[@]}" | awk "$widest")
  local r pa pb
  for r in "${!a[@]}"; do
    pa=$(printf '%-*s' "$wa" "${a[r]}")
    pb=""
    [[ -n $unit ]] && pb=$(printf '    %-*s' "$wb" "${b[r]:-}")
    [[ -z ${pa// /}${pb// /} ]] && continue
    printf '\e[1;38;5;%sm%s\e[1;38;5;%sm%s%s\n' "$c1" "$pa" "$c2" "$pb" "$R"
  done
}

# Large figlet headline of the key specs; skipped if figlet is missing or BIG=off.
# BIG splits into segments on "|", each drawn in its own colour (COLORS, with
# COLORS2 for the trailing unit word), side by side when the terminal is wide
# enough, otherwise stacked.
render_banner() {
  local text=${CFG[BIG]:-}
  command -v figlet >/dev/null || return 0
  [[ $text == off ]] && return 0
  if [[ -z $text ]]; then
    # Default: "32 GB RAM|128 GB SSD" from the RAM and STORAGE fields. Spelling
    # out RAM matters: on a Chromebook a bare "32 GB" reads as eMMC size.
    text="$(field_value RAM) RAM|$(field_value STORAGE)"
  fi

  local font=${CFG[FONT]:-banner} cols gap=6 R=$'\e[0m'
  cols=$(tput cols 2>/dev/null || echo 80)
  local -a colors colors2 segs
  read -r -a colors <<<"${CFG[COLORS]:-81 214 177 114}"
  read -r -a colors2 <<<"${CFG[COLORS2]:-117 222 183 151}"
  IFS='|' read -r -a segs <<<"$text"

  # Render each segment; rows come back coloured and padded to its width.
  local -a widths=() blocks=()
  local i height=0 total=2
  for i in "${!segs[@]}"; do
    local out w
    out=$(banner_segment "${segs[i]# }" "${colors[i % ${#colors[@]}]}" \
      "${colors2[i % ${#colors2[@]}]}" "$font")
    w=$(sed 's/\x1b\[[0-9;]*m//g' <<<"$out" | awk '{ if (length > m) m = length } END { print m + 0 }')
    widths+=("$w"); blocks+=("$out")
    (( total += w + (i ? gap : 0) ))
    local h; h=$(wc -l <<<"$out"); (( h > height )) && height=$h
  done

  # Solid blocks read far better than "#" in a photo.
  local solid='s/#/█/g'
  echo
  if (( total <= cols )); then
    local r
    for (( r = 1; r <= height; r++ )); do
      local line="  "
      for i in "${!blocks[@]}"; do
        local row
        row=$(sed -n "${r}p" <<<"${blocks[i]}")
        [[ -z $row ]] && row=$(printf '%*s' "${widths[i]}" '')
        (( i )) && line+=$(printf '%*s' "$gap" '')
        line+=$row
      done
      sed "$solid" <<<"$line"
    done
  else
    for i in "${!blocks[@]}"; do
      (( i )) && echo
      sed "$solid; s/^/  /" <<<"${blocks[i]}"
    done
  fi
}

render() {
  local accent=${CFG[ACCENT]:-39}
  local A=$'\e[1;38;5;'"$accent"'m' D=$'\e[2m' B=$'\e[1m' R=$'\e[0m' G=$'\e[38;5;114m'
  local header=${CFG[HEADER]:-$USER@$(hostname)}

  local art=(
    "  ╭────────────────────╮"
    "  │ ┌────────────────┐ │"
    "  │ │ ${G}\$${R} devfetch     │ │"
    "  │ │ ${G}>${R} ready.       │ │"
    "  │ │ ${G}█${R}              │ │"
    "  │ └────────────────┘ │"
    "  ╰─┬────────────────┬─╯"
    " ▁▁▁┴────────────────┴▁▁▁"
    " ▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔"
  )
  local art_width=26

  local rule
  rule=$(printf '%*s' "${#header}" '')
  local info=("${A}${header}${R}" "${D}${rule// /─}${R}")
  local k v
  for k in "${BUILTIN[@]}"; do
    v=$(field_value "$k")
    [[ -n $v ]] && info+=("${A}$(label_for "$k")${R}: $v")
  done
  for k in "${CFG_KEYS[@]}"; do
    [[ " ${BUILTIN[*]} ${SETTINGS[*]} " == *" $k "* ]] && continue
    info+=("${A}$(label_for "$k")${R}: ${CFG[$k]}")
  done
  [[ -n ${CFG[TAGLINE]:-} ]] && info+=("" "${B}${CFG[TAGLINE]}${R}")
  local palette="" c
  for c in 0 1 2 3 4 5 6 7; do palette+=$'\e[4'"$c"'m   '; done
  info+=("" "$palette$R")

  # Art is vertically centred against the info column.
  local n=${#info[@]} m=${#art[@]} i
  (( n > m )) || n=$m
  local offset=$(( (n - m) / 2 ))
  render_banner
  echo
  for (( i = 0; i < n; i++ )); do
    local a=""
    (( i >= offset && i - offset < m )) && a=${art[i - offset]}
    # Pad art by visible width (strip colour codes before measuring).
    local plain
    plain=$(printf '%s' "$a" | sed 's/\x1b\[[0-9;]*m//g')
    printf '%s%*s   %s\n' "$a" $(( art_width - ${#plain} )) '' "${info[i]:-}"
  done
  echo
}

# --- CLI --------------------------------------------------------------------

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; }

load_config
case ${1:-} in
  "") render ;;
  --set)
    [[ $# -ge 3 ]] || { echo 'usage: devfetch --set KEY "value"' >&2; exit 1; }
    k=$(normalize_key "$2"); shift 2
    [[ -v CFG[$k] ]] || CFG_KEYS+=("$k")
    CFG[$k]="$*"
    save_config
    echo "set $k = $*"
    ;;
  --unset)
    [[ $# -ge 2 ]] || { echo 'usage: devfetch --unset KEY' >&2; exit 1; }
    k=$(normalize_key "$2")
    unset 'CFG[$k]'
    save_config
    echo "unset $k"
    ;;
  --config) cat "$CONFIG" ;;
  --edit) "${EDITOR:-nano}" "$CONFIG" ;;
  -h|--help) usage ;;
  *) echo "devfetch: unknown option '$1'" >&2; usage >&2; exit 1 ;;
esac
